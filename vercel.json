{"buildCommand":"node build-seo.js","outputDirectory":"dist","cleanUrls":true,"trailingSlash":false,
"rewrites":[{"source":"/((?!api/|assets/|config.js|landing-data.js|sitemap.xml|robots.txt|llms.txt).*)","destination":"/app.html"}],
"headers":[{"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public,max-age=31536000,immutable"}]},{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]}
